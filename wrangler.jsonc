{
  // Sitio estático servido por Cloudflare Workers (static assets), sin paso de build.
  "name": "conlang",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    // Servir los .html tal cual: sin esto Cloudflare redirige vocablos.html → /vocablos en cada clic.
    "html_handling": "none"
  }
}
